[core]
        editor = nano -w
[push]
        default = current
[init]
        defaultBranch = main
[alias]
        root = rev-parse --show-toplevel
        default-branch = symbolic-ref refs/remotes/origin/HEAD --short
        base-commit = !bash -c 'git merge-base $( git symbolic-ref refs/remotes/origin/HEAD --short ) HEAD'
        remote-uri = !bash -c 'git remote get-url $( git remote )'
        last-push = rev-parse @{push}
